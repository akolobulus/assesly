rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Business directory images - allow read for all, write for authenticated users
    match /business-directory-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Form meta images - allow read for all, write only for owners
    match /formMetaImages/{formId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.metadata.ownerUid;
    }
    
    // Submissions - allow authenticated users to read/write
    match /submissions/{formId}/{submissionId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Opportunity images - allow read for all, write for authenticated users
    match /opportunity-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Profile pictures - allow read for all, write only for own profile
    match /profilePictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Investor logos - allow read for all, write for authenticated users
    match /investor-logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}