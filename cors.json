
[
  {
    "origin": ["*"],
    "method": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
    "responseHeader": [
      "Content-Type", 
      "Authorization", 
      "Content-Length", 
      "User-Agent", 
      "x-goog-resumable",
      "x-goog-content-length-range",
      "x-goog-meta-owneruid",
      "x-goog-meta-formid",
      "x-goog-meta-submissionid"
    ],
    "maxAgeSeconds": 3600
  }
]
